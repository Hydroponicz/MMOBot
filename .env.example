# Copy to .env and fill in. See README.md for the full setup walkthrough.

# ---- Website ----
PORT=3000
# Public URL of your site (no trailing slash). Must be https:// in production for Kick webhooks.
BASE_URL=http://localhost:3000
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Where the SQLite database is stored.
# DB_PATH=./data/mmobot.db

# ---- Kick ----
# Create an app at https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Your Kick channel name (the part after kick.com/). This account becomes the site admin.
KICK_CHANNEL=
# Other Kick usernames allowed on the admin page (comma separated), e.g. your mods.
ADMIN_USERS=

# How the bot reads chat:
#   webhook = official Kick webhooks (recommended; needs a public https BASE_URL)
#   pusher  = Kick's public chat websocket (works on localhost; unofficial)
CHAT_SOURCE=webhook
# Only for CHAT_SOURCE=pusher: open https://kick.com/api/v2/channels/<your-channel> and copy chatroom.id
KICK_CHATROOM_ID=
# Verify Kick webhook signatures (keep true in production).
VERIFY_WEBHOOKS=true

# ---- Game tuning ----
COMMAND_PREFIX=!
# Seconds between skilling actions per viewer.
ACTION_COOLDOWN_SECONDS=30
# Points for chatting, awarded at most once per CHAT_POINTS_COOLDOWN_SECONDS per viewer.
CHAT_POINTS=5
CHAT_POINTS_COOLDOWN_SECONDS=60
# Reply to commands in Kick chat.
REPLY_IN_CHAT=true

# ---- Development ----
# Adds a "Test chat" page so you can play without Kick. Never enable on a public server.
DEV_MODE=false
