# Copy to .env for local development. On Railway, set these in the service's Variables tab instead.
# See README.md for the full setup walkthrough.

# ---- Kick (required) ----
# Create an app at https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Your Kick channel name (the part after kick.com/). This account becomes the site admin.
KICK_CHANNEL=
# Other Kick usernames allowed on the admin page (comma separated), e.g. your mods.
ADMIN_USERS=

# ---- Website (optional on Railway) ----
# Public URL of your site, no trailing slash. On Railway this defaults to https://$RAILWAY_PUBLIC_DOMAIN.
# BASE_URL=http://localhost:3000
# PORT=3000
# Signs login cookies. If empty, a random secret is generated and stored in the database.
# SESSION_SECRET=
# SQLite file location. On Railway this defaults to <volume mount path>/mmobot.db.
# DB_PATH=./data/mmobot.db
# Verify Kick webhook signatures (keep true).
# VERIFY_WEBHOOKS=true

# ---- Game tuning ----
COMMAND_PREFIX=!
# Seconds between skilling actions per viewer.
ACTION_COOLDOWN_SECONDS=30
# Points for chatting, awarded at most once per CHAT_POINTS_COOLDOWN_SECONDS per viewer.
CHAT_POINTS=5
CHAT_POINTS_COOLDOWN_SECONDS=60
# Reply to commands in Kick chat.
REPLY_IN_CHAT=true
# Hours for HP and mana to refill from empty. Knocked-out players fight again after HP_REGEN_HOURS (or after a health potion).
HP_REGEN_HOURS=24
MANA_REGEN_HOURS=12
# Emotes that work as commands: emote=command pairs, comma separated (also editable on the admin page).
EMOTE_COMMANDS=hydroponiczcobble=mine
# Casino (slots, roulette, plinko, blackjack). Starting defaults; editable on the admin page.
CASINO_ENABLED=true
CASINO_MIN_BET=10
# 0 = no maximum bet.
CASINO_MAX_BET=0
# Seconds between bets per viewer (blackjack !hit/!stand don't count).
CASINO_COOLDOWN_SECONDS=5

# ---- Development ----
# Adds a "Test chat" page so you can play without Kick. Never enable on a public server.
DEV_MODE=false
